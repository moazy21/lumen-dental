# LUMEN Dental — environment template. Copy to .env (gitignored) for local dev,
# and set the same values in the Vercel dashboard (Project → Settings → Environment Variables).

# OpenAI — powers the RAG chat assistant (gpt-4o-mini by default, pennies per chat)
OPENAI_API_KEY=

# Resend — sends booking request emails to the clinic inbox (free 100/day)
RESEND_API_KEY=
# Inbox that receives booking requests, e.g. bookings@lumendental.example.com
CLINIC_INBOX=
# Verified sender. Resend test mode: onboarding@resend.dev (delivers to your own address only).
# Production: verify your domain at resend.com/domains, then use bookings@yourdomain.com
CLINIC_FROM=onboarding@resend.dev
