---
import { navLinks, site } from '../data/site.ts';
import Icon from './Icon.astro';
---
<footer class="bg-pine text-porcelain mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-[28px] tracking-[0.08em] font-extrabold">LUMEN</p>
      <p class="mt-3 text-sm text-porcelain/70 max-w-[32ch] leading-relaxed">Family dentistry in Berkeley. Written plans, exact pricing, nervous patients welcome.</p>
      <p class="mt-4 text-sm flex items-center gap-1.5"><span class="inline-flex gap-0.5 text-aqua" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span><span class="sr-only">Rated</span> {site.rating} from {site.reviewCount} patients</p>
    </div>
    <nav aria-label="Footer">
      <p class="text-[12px] uppercase tracking-[0.16em] text-porcelain/55 mb-4">Explore</p>
      <ul class="space-y-2.5 text-[15px]">
        {navLinks.map(l => <li><a class="hover:underline underline-offset-4" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-[12px] uppercase tracking-[0.16em] text-porcelain/55 mb-4">Visit</p>
      <p class="text-sm leading-relaxed">{site.address}</p>
      <ul class="mt-3 text-sm space-y-1.5 text-porcelain/80">
        {site.hours.map(h => <li class="flex justify-between gap-4"><span>{h[0]}</span><span>{h[1]}</span></li>)}
      </ul>
    </div>
    <div>
      <p class="text-[12px] uppercase tracking-[0.16em] text-porcelain/55 mb-4">Book</p>
      <a href={site.phoneHref} class="text-lg font-bold hover:underline underline-offset-4">{site.phone}</a>
      <div class="mt-4">
        <a href="/book" class="inline-block bg-porcelain text-pine font-bold px-6 py-3 rounded-full text-sm hover:bg-white transition">Book a visit</a>
      </div>
    </div>
  </div>
  <div class="border-t border-porcelain/15">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-porcelain/55">
      <span>© 2026 LUMEN Family Dental. Demonstration site with sample content and pricing.</span>
      <span>General information only, not medical advice.</span>
    </div>
  </div>
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
