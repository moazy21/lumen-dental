---
import { navLinks, site } from '../data/site.ts';
import Logo from './Logo.astro';
---
<div class="bg-pine text-porcelain text-center text-[13px] py-2 px-4">
  Tooth pain? We hold same-day slots every weekday morning. <a href={site.phoneHref} class="underline underline-offset-2 font-bold">Call {site.phone}</a>
</div>
<header class="sticky top-0 z-40 bg-porcelain/90 backdrop-blur border-b border-line">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 h-[68px] flex items-center justify-between gap-4" aria-label="Primary">
    <a href="/" aria-label="LUMEN home"><Logo /></a>
    <div class="hidden lg:flex items-center gap-7 text-[15px] font-bold">
      {navLinks.map(l => <a href={l.href} class="hover:opacity-60 transition">{l.label}</a>)}
    </div>
    <div class="flex items-center gap-3">
      <a href={site.phoneHref} class="hidden md:inline text-sm font-bold">{site.phone}</a>
      <a href="/book" class="btn-primary bg-pine text-porcelain text-sm font-bold px-5 py-2.5 rounded-full hover:bg-pincedeep transition whitespace-nowrap">Book visit</a>
      <button id="menuBtn" class="lg:hidden w-11 h-11 grid place-items-center rounded-full border border-line" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </nav>
  <div id="mobileMenu" class="hidden lg:hidden border-t border-line bg-porcelain px-4 py-2">
    <div class="grid text-[17px] font-bold">
      {navLinks.map(l => <a href={l.href} class="py-3 border-b border-line last:border-0">{l.label}</a>)}
      <a href={site.phoneHref} class="py-3 font-extrabold">{site.phone}</a>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('mobileMenu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', open ? 'false' : 'true');
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
  });
</script>
