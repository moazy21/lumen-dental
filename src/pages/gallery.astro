---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = [
  ['Whitening','5 shades brighter, one visit','Sample case for layout','https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=700&q=80&auto=format&fit=crop'],
  ['Kids dentistry','First visit, sticker earned','Sample case for layout','https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=700&q=80&auto=format&fit=crop'],
  ['Checkup rhythm','6-month recalls, healthy gums','Sample case for layout','https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=700&q=80&auto=format&fit=crop'],
  ['Happy patients','900+ reviews and counting','Sample case for layout','https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=700&q=80&auto=format&fit=crop'],
  ['Gentle care','Nervous patients welcome','Sample case for layout','https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=700&q=80&auto=format&fit=crop'],
  ['Modern rooms','Digital everything','Sample case for layout','https://images.unsplash.com/photo-1629909615184-74f495363b67?w=700&q=80&auto=format&fit=crop'],
];
---
<BaseLayout title="Smile gallery" description="Sample cases and patient stories from LUMEN Family Dental.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16">
    <h1 class="text-4xl sm:text-5xl lg:text-[58px] lg:leading-[1.05] font-extrabold tracking-tight">Ordinary teeth, well kept.</h1>
    <p class="mt-3 text-ink/70 max-w-[55ch] text-[15px]">Sample photography for layout. Real dentistry is mostly prevention — less dramatic, better outcomes.</p>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map(r => (
        <figure class="bg-white border border-line rounded-[20px] overflow-hidden">
          <img src={r[3]} alt={r[0]} loading="lazy" decoding="async" width="700" height="525" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="p-5"><p class="text-lg font-extrabold tracking-tight">{r[0]}</p><p class="text-sm text-ink/70">&ldquo;{r[1]}&rdquo;</p><p class="text-xs font-bold mt-2 text-ink/55">{r[2]}</p></figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-10 bg-pine text-porcelain rounded-[22px] p-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Your smile, kept.</h2>
      <a href="/book" class="mt-4 inline-block bg-porcelain text-pine font-bold px-8 py-3 rounded-full text-sm">Book a checkup</a>
    </div>
  </section>
</BaseLayout>
