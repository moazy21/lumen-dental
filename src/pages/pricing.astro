---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { faqs } from '../data/site.ts';
const tiers = [
  { name: 'Essential', price: 29, perks: ['2 exams + X-rays / year', '2 hygiene cleans / year', '10% off treatments'] },
  { name: 'Plus', price: 49, popular: true, perks: ['Everything in Essential', '15% off treatments', 'Annual whitening top-up', 'Priority emergency slots'] },
  { name: 'Family', price: 119, perks: ['Covers 2 adults + 2 kids', 'Everything in Plus, for all', 'Free sealants for kids', 'One bill, cancel anytime'] },
];
---
<BaseLayout title="Pricing and LUMEN Plans" description="Transparent dental pricing and LUMEN Plans from $29 per month. No maximums, no waiting periods.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16 text-center">
    <h1 class="text-4xl sm:text-5xl lg:text-[58px] lg:leading-[1.05] font-extrabold tracking-tight">Pay per visit, or join a plan.</h1>
    <p class="mt-3 text-ink/70 max-w-[52ch] mx-auto">Sample pricing for layout. Written estimates always come before treatment — no surprises, ever.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5 text-left items-stretch max-w-5xl mx-auto">
      <div class="bg-white border border-line rounded-[22px] p-7">
        <p class="font-bold">Pay per visit</p>
        <p class="text-4xl mt-2 font-extrabold tracking-tight tabular-nums">From $89</p>
        <ul class="mt-4 text-sm space-y-2.5 text-ink/70">
          <li class="flex gap-2"><span class="mt-0.5 text-aquadeep"><Icon name="check" size={14} /></span>New patient exam from $89</li>
          <li class="flex gap-2"><span class="mt-0.5 text-aquadeep"><Icon name="check" size={14} /></span>Hygiene clean from $129</li>
          <li class="flex gap-2"><span class="mt-0.5 text-aquadeep"><Icon name="check" size={14} /></span>PPO claims filed for you</li>
        </ul>
        <a href="/book" class="mt-6 block text-center border border-pine/20 font-bold py-3 rounded-full text-sm">Book a visit</a>
      </div>
      {tiers.map(t => (
        <div class={`rounded-[22px] p-7 border ${t.popular ? 'bg-pine text-porcelain border-pine relative' : 'bg-white border-line'}`}>
          {t.popular && <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-aqua text-pine text-xs font-extrabold px-4 py-1 rounded-full whitespace-nowrap">Most popular</span>}
          <p class="font-bold">{t.name}</p>
          <p class="text-5xl mt-2 font-extrabold tabular-nums tracking-tight">${t.price}<span class="text-base font-sans font-bold">/mo</span></p>
          <ul class={`mt-4 text-sm space-y-2.5 ${t.popular ? 'text-porcelain/80' : 'text-ink/70'}`}>
            {t.perks.map(p => <li class="flex gap-2"><span class="mt-0.5"><Icon name="check" size={14} /></span>{p}</li>)}
          </ul>
          <a href="/book" class={`mt-6 block text-center font-bold py-3 rounded-full text-sm ${t.popular ? 'bg-porcelain text-pine' : 'bg-pine text-porcelain'}`}>Join {t.name}</a>
        </div>
      ))}
    </div>
  </section>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <h2 class="text-2xl sm:text-3xl text-center font-extrabold tracking-tight">Money questions</h2>
    <div class="mt-6 border-t border-line">
      {faqs.slice(0,4).map(f => <div class="py-4 border-b border-line"><p class="font-bold">{f.q}</p><p class="mt-2 text-sm text-ink/70">{f.a}</p></div>)}
    </div>
  </section>
</BaseLayout>
